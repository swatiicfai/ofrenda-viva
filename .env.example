# Ofrenda Viva - Configuration Settings (Optional)
PORT=3000

# Gemma Local Ollama Configuration (Defaults to http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434
GEMMA_MODEL=gemma2:2b

# Optional: ElevenLabs Text-to-Speech API Key
# If omitted, Ofrenda Viva seamlessly falls back to client Web Speech API
ELEVENLABS_API_KEY=

# Optional: MongoDB Atlas Connection URI
MONGODB_URI=
